#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
API_URL="${FINANCE_API_BASE_URL:-}"
WEB_PORT="${WEB_PORT:-}"
AUTH_TOKEN="${FINANCE_API_DEV_TOKEN:-}"
API_PID=""
WEB_PID=""

export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/local/go/bin:${PATH}"

load_env_file() {
  local file="$1"
  if [[ -f "$file" ]]; then
    set -a
    # shellcheck disable=SC1090
    source "$file"
    set +a
  fi
}

cleanup() {
  if [[ -n "${WEB_PID}" ]]; then
    kill "${WEB_PID}" 2>/dev/null || true
  fi
  if [[ -n "${API_PID}" ]]; then
    kill "${API_PID}" 2>/dev/null || true
  fi
}

trap cleanup EXIT INT TERM

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "Missing required command: $1" >&2
    exit 1
  fi
}

require_env() {
  if [[ -z "${!1:-}" ]]; then
    echo "Missing required environment variable: $1" >&2
    exit 1
  fi
}

port_is_listening() {
  local port="$1"
  lsof -nP -iTCP:"${port}" -sTCP:LISTEN >/dev/null 2>&1
}

health_ok() {
  curl -fsS --max-time 2 "${API_URL}/v1/health" >/dev/null 2>&1
}

wait_for_url() {
  local url="$1"
  for _ in $(seq 1 45); do
    if curl -fsS --max-time 2 "$url" >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
  done
  return 1
}

load_env_file "${ROOT_DIR}/services/api/.env"
load_env_file "${ROOT_DIR}/apps/web/.env.local"

API_URL="${FINANCE_API_BASE_URL:-${API_URL:-http://127.0.0.1:8080}}"
WEB_PORT="${WEB_PORT:-3025}"
AUTH_TOKEN="${FINANCE_API_DEV_TOKEN:-${AUTH_TOKEN:-dev:user_demo}}"

if [[ -z "${VERCEL_AI_GATEWAY_API_KEY:-}" && -n "${AI_GATEWAY_API_KEY:-}" ]]; then
  export VERCEL_AI_GATEWAY_API_KEY="${AI_GATEWAY_API_KEY}"
fi

require_command curl
require_command node
require_command npm
require_command go
require_env VERCEL_AI_GATEWAY_API_KEY
require_env SUPABASE_URL
require_env SUPABASE_SERVICE_ROLE_KEY

if ! health_ok; then
  echo "Starting Finance API at ${API_URL}"
  (
    cd "${ROOT_DIR}/services/api"
    go run ./cmd/api
  ) &
  API_PID="$!"

  if ! wait_for_url "${API_URL}/v1/health"; then
    echo "Finance API did not become healthy at ${API_URL}" >&2
    exit 1
  fi
fi

if port_is_listening "${WEB_PORT}"; then
  echo "Port ${WEB_PORT} is already in use. Set WEB_PORT to a free port." >&2
  exit 1
fi

echo "Starting Next.js Phase 5 live verifier at http://127.0.0.1:${WEB_PORT}"
(
  cd "${ROOT_DIR}/apps/web"
  FINANCE_API_BASE_URL="${API_URL}" \
    FINANCE_API_DEV_TOKEN="${AUTH_TOKEN}" \
    AI_PORTFOLIO_BRIEF_MODE=live \
    VERCEL_AI_GATEWAY_API_KEY="${VERCEL_AI_GATEWAY_API_KEY}" \
    SUPABASE_URL="${SUPABASE_URL}" \
    SUPABASE_SERVICE_ROLE_KEY="${SUPABASE_SERVICE_ROLE_KEY}" \
    npm run dev -- -p "${WEB_PORT}"
) &
WEB_PID="$!"

if ! wait_for_url "http://127.0.0.1:${WEB_PORT}"; then
  echo "Next.js did not become ready on port ${WEB_PORT}" >&2
  exit 1
fi

echo "Creating owner-scoped provider-backed portfolio fixture"
curl -fsS -X POST "${API_URL}/v1/portfolios" \
  -H "Authorization: Bearer ${AUTH_TOKEN}" \
  -H "Content-Type: application/json" \
  -d '{"name":"Phase 5 live verification portfolio","baseCurrency":"USD","initialHoldings":[{"ticker":"AAPL","quantity":1,"averageCostCents":0,"notes":"Phase 5 live AI verification holding."}]}' >/dev/null

echo "Calling live AI portfolio brief route"
response_file="$(mktemp)"
http_status="$(
  curl -sS -o "${response_file}" -w "%{http_code}" \
    -X POST "http://127.0.0.1:${WEB_PORT}/api/ai/portfolio-brief" \
    -H "Authorization: Bearer ${AUTH_TOKEN}" \
    -H "Content-Type: application/json" \
    -d '{"prompt":"Summarize concentration risk and data freshness as research. Include citations and assumptions."}'
)"

if [[ "${http_status}" != "200" ]]; then
  echo "Live portfolio brief failed with HTTP ${http_status}" >&2
  cat "${response_file}" >&2
  exit 1
fi

node - "${response_file}" <<'NODE'
const fs = require("node:fs");
const payload = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const failures = [];

if (payload.meta?.liveAiGatewayCall !== true) failures.push("liveAiGatewayCall was not true");
if (payload.meta?.mode !== "live") failures.push("mode was not live");
if (payload.meta?.model === "deterministic-fixture") failures.push("model was deterministic fixture");
if (payload.meta?.persistence?.status !== "persisted") failures.push("persistence was not persisted");
if (!payload.meta?.persistence?.threadId) failures.push("threadId missing");
if (!payload.meta?.persistence?.briefId) failures.push("briefId missing");
if (!payload.meta?.persistence?.toolRunId) failures.push("toolRunId missing");
if (!payload.meta?.persistence?.usageEventId) failures.push("usageEventId missing");
if (!Array.isArray(payload.meta?.persistence?.messageIds) || payload.meta.persistence.messageIds.length < 2) {
  failures.push("messageIds missing");
}
if (!Array.isArray(payload.data?.citations) || payload.data.citations.length < 1) failures.push("citations missing");
if (payload.data?.safetyLabel !== "research_only") failures.push("safetyLabel was not research_only");
if (!payload.data?.disclaimer?.toLowerCase().includes("not financial advice")) failures.push("disclaimer missing");

if (failures.length > 0) {
  console.error(`Phase 5 live verification failed: ${failures.join(", ")}`);
  process.exit(1);
}

console.log("Phase 5 live verification passed.");
console.log(JSON.stringify({
  model: payload.meta.model,
  threadId: payload.meta.persistence.threadId,
  briefId: payload.meta.persistence.briefId,
  citationCount: payload.data.citations.length,
}, null, 2));
NODE
