#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MIGRATIONS_DIR="$ROOT_DIR/supabase/migrations"

if [[ ! -d "$MIGRATIONS_DIR" ]]; then
  echo "Missing migrations directory: $MIGRATIONS_DIR" >&2
  exit 1
fi

if ! find "$MIGRATIONS_DIR" -name '*.sql' -print -quit | grep -q .; then
  echo "No SQL migrations found in $MIGRATIONS_DIR" >&2
  exit 1
fi

if grep -RniE '\b(real|double precision|float[48]?)\b' "$MIGRATIONS_DIR"; then
  echo "Financial schema must not use floating point types." >&2
  exit 1
fi

if ! grep -Rqi 'enable row level security' "$MIGRATIONS_DIR"; then
  echo "Migrations must enable RLS for user-owned tables." >&2
  exit 1
fi

if ! grep -Rqi 'create extension if not exists vector' "$MIGRATIONS_DIR"; then
  echo "Migrations must enable pgvector for v1 research retrieval." >&2
  exit 1
fi

for table in profiles portfolios holdings watchlists ai_threads ai_messages usage_events audit_logs webhook_events research_workspaces document_pages document_processing_jobs; do
  if ! grep -Rqi "create table if not exists public.$table" "$MIGRATIONS_DIR"; then
    echo "Missing required table: $table" >&2
    exit 1
  fi
done

for column in stripe_price_id cancel_at_period_end entitlements last_webhook_event_id; do
  if ! grep -Rqi "$column" "$MIGRATIONS_DIR"; then
    echo "Missing Phase 7 subscription column in migrations: $column" >&2
    exit 1
  fi
done

if grep -RniE 'demo-seed|deterministic-demo-data|demo_universe' "$MIGRATIONS_DIR"; then
  echo "Migrations must not seed mock market prices or demo freshness states." >&2
  exit 1
fi

PHASE1_MIGRATION="$(find "$MIGRATIONS_DIR" -name '*_phase10_document_foundation.sql' -print -quit)"
if [[ -z "$PHASE1_MIGRATION" ]]; then
  echo "Missing Phase 1 document foundation migration." >&2
  exit 1
fi

for requirement in \
  "create role aperture_api" \
  "alter table public.research_workspaces force row level security" \
  "alter table public.research_documents force row level security" \
  "alter table public.document_pages force row level security" \
  "research_workspaces_own_rows" \
  "research_documents_own_rows" \
  "document_pages_own_rows" \
  "document_processing_jobs_service_only" \
  "document_processing_jobs_api_own_rows" \
  "'research-documents'" \
  "false,"; do
  if ! grep -Rqi "$requirement" "$MIGRATIONS_DIR"; then
    echo "Missing Phase 1 document security requirement: $requirement" >&2
    exit 1
  fi
done

for retired_policy in research_documents_read_all research_chunks_read_all; do
  if ! grep -qi "drop policy if exists $retired_policy" "$PHASE1_MIGRATION"; then
    echo "Phase 1 must remove global policy: $retired_policy" >&2
    exit 1
  fi
done

echo "Supabase migration static validation passed."
