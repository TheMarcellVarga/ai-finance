#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SPEC="$ROOT_DIR/packages/contracts/openapi/finance-api.yaml"
CLIENT="$ROOT_DIR/packages/contracts/src/generated/client.ts"

if [[ ! -f "$SPEC" ]]; then
  echo "Missing OpenAPI spec: $SPEC" >&2
  exit 1
fi

for operation in getHealth searchAssets getAssetQuote getAssetIntraday getCurrentPrincipal getUsage listPortfolios createPortfolio getPortfolio updatePortfolio deletePortfolio addHolding listWatchlists createWatchlist addWatchlistItem; do
  if ! grep -q "operationId: $operation" "$SPEC"; then
    echo "OpenAPI spec is missing operationId: $operation" >&2
    exit 1
  fi
done

if [[ ! -f "$CLIENT" ]]; then
  echo "Missing generated TypeScript client: $CLIENT" >&2
  exit 1
fi

if ! grep -q "class FinanceApiClient" "$CLIENT"; then
  echo "Generated client does not export FinanceApiClient" >&2
  exit 1
fi

echo "OpenAPI contract and generated TypeScript client are present."
