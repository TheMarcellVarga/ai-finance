APP_ENV=development
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=info

# Local development can use "dev" auth with Authorization: Bearer dev:<clerk_user_id>.
# Production must use API_AUTH_MODE=clerk with Clerk issuer/JWKS values.
API_AUTH_MODE=dev
API_DEV_AUTH_PREFIX=dev:
CLERK_JWT_ISSUER=
CLERK_JWT_AUDIENCE=
CLERK_JWKS_URL=

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres?sslmode=disable

# Development defaults to in-memory metadata and private local files. To exercise
# the durable path, set postgres + supabase and provide the server-only values.
RESEARCH_PERSISTENCE_MODE=memory
# Set true on finance-only deployments to disable document research routes.
RESEARCH_DISABLED=false
DOCUMENT_STORAGE_MODE=local
DOCUMENT_STORAGE_DIR=./var/research-documents
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PDFTOTEXT_PATH=
DOCUMENT_WORKER_POLL_INTERVAL=2s

# Local/CI defaults to deterministic, no-cost embeddings. External embeddings
# require both the provider selection and the exact external-call kill switch.
RESEARCH_EMBEDDING_PROVIDER=local
RESEARCH_EMBEDDING_MODEL=
AI_EXTERNAL_CALLS_ENABLED=false
OPENAI_API_KEY=
# Production rejects the local embedder unless this deliberate override is true.
ALLOW_LOCAL_RESEARCH_EMBEDDINGS_IN_PRODUCTION=false

# Real provider keys. Keep these server-side only.
FMP_API_KEY=
TWELVE_DATA_API_KEY=
FINNHUB_API_KEY=
FINNHUB_WEBHOOK_SECRET=
SEC_USER_AGENT=your-email@example.com
