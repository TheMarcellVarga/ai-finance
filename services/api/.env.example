APP_ENV=development
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=info

# Local development can use "dev" auth with Authorization: Bearer dev:<clerk_user_id>.
# Production must use API_AUTH_MODE=clerk with Clerk issuer/JWKS values.
API_AUTH_MODE=dev
API_DEV_AUTH_PREFIX=dev:
CLERK_JWT_ISSUER=
CLERK_JWT_AUDIENCE=
CLERK_JWKS_URL=

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres?sslmode=disable

# Real provider keys. Keep these server-side only.
FMP_API_KEY=
TWELVE_DATA_API_KEY=
FINNHUB_API_KEY=
FINNHUB_WEBHOOK_SECRET=
SEC_USER_AGENT=your-email@example.com
