{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:structured-research": "node --import tsx --test src/lib/ai/structured-research.test.ts",
    "test:research-review": "node --import tsx --test src/lib/ai/research-review.test.ts",
    "test:reviewed-markdown": "node --import tsx --test src/lib/ai/reviewed-markdown.test.ts",
    "test:evidence-evaluation": "node --import tsx --test src/lib/ai/evidence-evaluation.test.ts",
    "eval:evidence": "node --import tsx scripts/evaluate-evidence-workspace.ts",
    "test:phase3": "npm run test:structured-research",
    "test:phase4": "npm run test:structured-research",
    "test:phase5": "npm run test:structured-research && npm run test:research-review && npm run test:reviewed-markdown",
    "test:phase6": "npm run test:phase5 && npm run test:evidence-evaluation && npm run eval:evidence"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.65",
    "@clerk/nextjs": "^7.4.2",
    "ai": "^6.0.191",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.3.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/swc-wasm-nodejs": "16.3.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.23"
  }
}
